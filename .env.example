# Dummy placeholders only. These values do not connect any external service.
DEMO_MODE=true
BAND_API_KEY=dummy-not-connected
FLEXPRICE_API_KEY=dummy-not-connected
FLEXPRICE_CUSTOMER_ID=demo-allco
# Optional project AI. Dummy values remain disabled and make no network calls.
PROJECT_AI_ENABLED=false
PROJECT_OPENAI_API_KEY=dummy-not-connected
PROJECT_OPENAI_MODEL=
# Set only for a deployment that listens beyond loopback. Never commit a real token.
# PROJECT_ACCESS_TOKEN=replace-with-a-project-specific-access-token
# PUBLIC_ORIGIN=https://your-project.example
# HOST=0.0.0.0
# PORT=3001
# DATA_DIR=.data

# Optional vendor contact research. Never use a personal or global key.
PROJECT_HUNTER_ENABLED=false
PROJECT_HUNTER_API_KEY=dummy-not-connected

# Optional ICP prospect search. Only reviewed queries are sent to Tavily.
PROJECT_TAVILY_ENABLED=false
PROJECT_TAVILY_API_KEY=dummy-not-connected

# Optional project Flexprice. Generic FLEXPRICE_* dummy values above are ignored.
# Configure separate existing customers/wallets and one SUM(credits) meter/price.
PROJECT_FLEXPRICE_ENABLED=false
PROJECT_FLEXPRICE_REGION=us
PROJECT_FLEXPRICE_API_KEY=dummy-not-connected
PROJECT_FLEXPRICE_METER_ID=
PROJECT_FLEXPRICE_PRICE_ID=
PROJECT_FLEXPRICE_ALLCO_ENABLED=false
PROJECT_FLEXPRICE_ALLCO_CUSTOMER_ID=
PROJECT_FLEXPRICE_ALLCO_EXTERNAL_CUSTOMER_ID=
PROJECT_FLEXPRICE_ALLCO_WALLET_ID=
PROJECT_FLEXPRICE_HUASHENG_ENABLED=false
PROJECT_FLEXPRICE_HUASHENG_CUSTOMER_ID=
PROJECT_FLEXPRICE_HUASHENG_EXTERNAL_CUSTOMER_ID=
PROJECT_FLEXPRICE_HUASHENG_WALLET_ID=
